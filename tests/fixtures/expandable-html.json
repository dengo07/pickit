{
  "name": "Expandable Notes",
  "engine": "html",
  "width": 300,
  "height": 80,
  "position": "top-right",
  "expandable": {"width": 300, "height": 260},
  "html": "<!doctype html><html><head><meta charset=\"utf-8\"><style>html,body{margin:0;height:100%;background:transparent;font-family:sans-serif;color:#fff}.card{box-sizing:border-box;height:100%;padding:12px 16px;border-radius:16px;background:rgba(30,30,40,.85);overflow:hidden}.head{display:flex;align-items:center;justify-content:space-between;cursor:pointer}.title{font-size:18px;font-weight:600}.chev{transition:transform .2s}[data-pickit-expanded=\"true\"] .chev{transform:rotate(180deg)}.body{display:none;margin-top:10px;font-size:14px;line-height:1.5}[data-pickit-expanded=\"true\"] .body{display:block}</style></head><body><div class=\"card\"><div class=\"head\" id=\"head\"><span class=\"title\">Today</span><span class=\"chev\">&#9660;</span></div><div class=\"body\"><ul><li>09:30 Standup</li><li>13:00 Lunch</li><li>16:00 Review</li></ul><button id=\"close\">Collapse</button></div></div><script>document.getElementById('head').addEventListener('click',function(){widget.toggle()});document.getElementById('close').addEventListener('click',function(){widget.collapse()});window.addEventListener('pickit-expand',function(e){document.title=e.detail&&e.detail.expanded?'open':'closed'});</script></body></html>"
}
