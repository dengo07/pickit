{
 "name": "CPU Graph",
 "engine": "native",
 "width": 300,
 "height": 160,
 "position": "top-right",
 "commands": {
  "c": {
   "cmd": "export LC_ALL=C; a=$(head -1 /proc/stat); sleep 0.5; b=$(head -1 /proc/stat); printf '%s\\n%s\\n' \"$a\" \"$b\" | awk '{i=$5+$6; t=0; for(n=2;n<=NF;n++) t+=$n; if(NR==1){i1=i;t1=t}else{dt=t-t1; printf \"cpu=%.1f\\n\", (dt>0? (dt-(i-i1))*100/dt : 0)}}'; echo \"cores=$(nproc)\"; echo \"load=$(cut -d' ' -f1-3 /proc/loadavg)\"",
   "interval": 2.0
  }
 },
 "ui": {
  "type": "card",
  "children": [
   {
    "type": "row",
    "children": [
     {
      "type": "column",
      "children": [
       {
        "type": "label",
        "text": "CPU",
        "size": 10,
        "weight": "semibold",
        "letter_spacing": 1.4,
        "color": "rgba(244,241,234,0.62)"
       },
       {
        "type": "label",
        "text": "{c.cores|default:–} cores · load {c.load|word:0|default:–}",
        "size": 10,
        "color": "rgba(244,241,234,0.4)"
       }
      ],
      "spacing": 2,
      "valign": "center"
     },
     {
      "type": "spacer"
     },
     {
      "type": "label",
      "text": "{c.cpu|round|default:--}%",
      "size": 30,
      "weight": "light",
      "color": "#f4f1ea"
     }
    ]
   },
   {
    "type": "sparkline",
    "value": "{c.cpu}",
    "points": 60,
    "min": 0,
    "max": 100,
    "color": "#5eead4",
    "fill": "rgba(94,234,212,0.16)",
    "line_width": 2,
    "height": 64
   }
  ],
  "spacing": 8
 },
 "gallery": {
