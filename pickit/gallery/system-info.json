{
 "name": "System Info",
 "engine": "native",
 "width": 300,
 "height": 188,
 "position": "bottom-left",
 "commands": {
  "s": {
   "cmd": ". /etc/os-release 2>/dev/null; echo \"os=${PRETTY_NAME:-Linux}\"; echo \"user=$(id -un)\"; echo \"host=$(cat /proc/sys/kernel/hostname)\"; echo \"kernel=$(uname -r)\"; echo \"up=$(cut -d' ' -f1 /proc/uptime)\"; echo \"load=$(cut -d' ' -f1-3 /proc/loadavg)\"; echo \"procs=$(ls -d /proc/[0-9]* | wc -l)\"",
   "interval": 60.0
  }
 },
 "ui": {
  "type": "card",
  "children": [
   {
    "type": "column",
    "children": [
     {
      "type": "label",
      "text": "{s.os|default:Linux}",
      "size": 15,
      "weight": "semibold",
      "color": "#f4f1ea",
      "ellipsize": true
     },
     {
      "type": "label",
      "text": "{s.user}@{s.host}",
      "size": 11,
      "color": "#f0a64a"
     }
    ],
    "spacing": 2
   },
   {
    "type": "column",
    "children": [
     {
      "type": "row",
