{
 "name": "Calendar",
 "engine": "native",
 "width": 300,
 "height": 262,
 "position": "top-left",
 "commands": {
  "cal": {
   "cmd": "python3 -c 'import calendar, datetime, json; t = datetime.date.today(); w = [[d or \"\" for d in wk] for wk in calendar.Calendar(0).monthdayscalendar(t.year, t.month)]; print(json.dumps({\"month\": t.strftime(\"%B %Y\"), \"today\": t.day, \"day\": t.strftime(\"%a %d\"), \"weeks\": len(w), \"w\": w + [[\"\"] * 7] * (6 - len(w))}))'",
   "interval": 300.0
  }
 },
